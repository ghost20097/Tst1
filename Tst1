--==================== PICA (segmentos sobrepostos) ====================
local function criarPica()
    local char = LP and LP.Character; if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local lt  = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or hrp
    if not (hrp and lt) then return end
    local sz = lt.Size
    local L = math.max(0.60, sz.X*0.46*S.tamPica)
    local d = math.max(0.11, sz.X*0.075*S.gross)
    local baseCF = CFrame.new(0, PICA_BASE_Y + S.picaY, PICA_BASE_Z) * P(-90,0,0)

    local raiz = Instance.new("Part")
    raiz.Name="Neko_PicaRaiz"; raiz.Size=V3(0.12,0.12,0.12); raiz.Shape=Enum.PartType.Ball
    raiz.Color=COR.pica; raiz.Material=Enum.Material.SmoothPlastic
    raiz.Anchored,raiz.CanCollide,raiz.Massless,raiz.CastShadow=false,false,true,false
    raiz.CanQuery,raiz.CanTouch=false,false; raiz.Parent=char
    local w = Instance.new("Weld"); w.Name="Neko_WeldPica"
    w.Part0,w.Part1=hrp,raiz; w.C0=baseCF; w.Parent=hrp

    local partes = {}
    local function pp(nome,c0,tam,c,forma,extra)
        local p=peca(nome,raiz,c0,tam,c,forma,extra); partes[#partes+1]=p; return p
    end

    -- saco + testiculos (encostados na base)
    pp("Neko_Saco",  CFrame.new(0, -L*0.06, 0.02), V3(d*2.4, d*1.5, d*1.8), COR.pica)
    for _,lado in ipairs({-1,1}) do
        pp("Neko_Bola", CFrame.new(lado*d*1.00, -L*0.08, 0.03)*P(0,0,lado*12), V3(d*1.35,d*1.48,d*1.35), COR.pica)
    end

    -- haste: 3 segmentos SOBREPOSTOS (sem vao)
    local segs = {
        { y=0.14, l=0.42, r=1.05, cz=0.000 },
        { y=0.46, l=0.38, r=1.00, cz=0.018 },
        { y=0.76, l=0.36, r=0.96, cz=0.040 },
    }
    for i,s in ipairs(segs) do
        pp("Neko_Haste"..i, CFrame.new(0, L*s.y, s.cz*L)*P(0,0,90 + i*1.7),
           V3(L*s.l, d*2*s.r, d*2*s.r), COR.pica, Enum.PartType.Cylinder)
    end

    -- veias
    pp("Neko_Veia1", CFrame.new( d*0.72, L*0.34, -d*0.55)*P(0,0,90), V3(L*0.52,d*0.19,d*0.19), COR.veia, Enum.PartType.Cylinder)
    pp("Neko_Veia2", CFrame.new(-d*0.72, L*0.24, -d*0.50)*P(0,0,90), V3(L*0.38,d*0.15,d*0.15), COR.veia, Enum.PartType.Cylinder)
    pp("Neko_Veia3", CFrame.new( d*0.22, L*0.58, -d*0.80)*P(0,0,88), V3(L*0.28,d*0.12,d*0.12), COR.veia, Enum.PartType.Cylinder)

    -- coroa + glande (encostados no fim da haste 3)
    pp("Neko_Coroa", CFrame.new(0, L*0.93, 0), V3(d*2.35, d*0.50, d*2.35), COR.glande)
    local cab = pp("Neko_Cabeca", CFrame.new(0, L*1.02, 0), V3(d*2.55, d*1.45, d*2.60), COR.glande)
    pp("Neko_Uretra", CFrame.new(0, L*1.13, -d*0.32), V3(d*0.32,d*0.15,d*0.38), Color3.fromRGB(206,120,124))
    local precum, precumW = pp("Neko_Precum", CFrame.new(0, L*1.16, -d*0.44), V3(d*0.32,d*0.36,d*0.32), COR.gota)
    precum.Material = Enum.Material.Glass; precum.Transparency = 1

    S.picaRaiz,S.picaWeld,S.picaBase,S.picaL = raiz,w,baseCF,L
    S.picaCabeca,S.precum,S.precumW = cab,precum,precumW
    S.precumBase = precumW.C0
    S.picaParts = partes
end

local function removerPica()
    local char = LP and LP.Character; if not char then return end
    for _,d in ipairs(char:GetDescendants()) do
        local n=d.Name
        if n:sub(1,10)=="Neko_Pica" or n=="Neko_Bola" or n=="Neko_Saco"
        or n=="Neko_WeldPica" or n=="Neko_Precum" or n=="Neko_Veia1"
        or n=="Neko_Veia2" or n=="Neko_Veia3" or n=="Neko_Coroa" or n=="Neko_Uretra" then
            pcall(function() d:Destroy() end)
        end
    end
    S.picaRaiz,S.picaWeld,S.picaCabeca,S.precum,S.precumW=nil,nil,nil,nil,nil
    S.picaParts={}
end

