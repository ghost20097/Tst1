local function fluido(pos, vel, cor, tam, viscoso)
    local g = Instance.new("Part")
    g.Name="Neko_Gota"; g.Shape=Enum.PartType.Ball; g.Size=V3(tam,tam,tam)
    g.Color=cor; g.Material=Enum.Material.Glass; g.Transparency=0.06
    g.Anchored,g.CanCollide,g.CanQuery,g.CanTouch,g.CastShadow=true,false,false,false,false
    g.CFrame=CFrame.new(pos); g.Parent=WS; S.gotas[#S.gotas+1]=g
    task.spawn(function()
        local p,v,t0,passo=pos,vel,tick(),0
        local dt=0.033
        while g.Parent and tick()-t0<2.4 do
            v=v+V3(0,-30*(viscoso and 0.55 or 1),0)*dt
            if viscoso then v=v*0.982 end
            p=p+v*dt; g.CFrame=CFrame.new(p); passo=passo+1
            if passo%3==0 then
                local r=WS:Raycast(p,V3(0,-0.6,0))
                if r then fazerPoca(r.Position+V3(0,0.02,0),cor,tam*(1.4+rnd()*1.6)); g:Destroy(); return end
            end
            task.wait(dt)
        end
        if g.Parent then g:Destroy() end
    end)
end
