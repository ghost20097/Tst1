    end)
    grupo("uniforme", function(g, tr)
        add(g, tr, CFrame.new(0,0.44,0), V3(1.94,1.06,1.04), COR.uniforme)
        add(g, tr, CFrame.new(0,-0.78,0), V3(0.52,2.02,2.02), COR.saia,
            Enum.PartType.Cylinder, P(0,0,90))
        add(g, tr, CFrame.new(0,0.50,-0.52), V3(0.16,0.62,0.10), COR.gravata)
    end)
    grupo("cosplay", function(g, tr)
        local cab = S.boneca.cabeca
        if cab then
            add(g, cab, CFrame.new(-0.40,0.80,0.10)*P(-14,0,-12), V3(0.10,0.55,0.46),
