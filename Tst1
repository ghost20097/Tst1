local function alvoLocal(pose, alvo)
    local raiz = pose.mot.raiz or IDENT
    if alvo=="boca" then
        local cab = pose.mot.cabeca or IDENT
        return raiz * CFrame.new(0,1.50,0) * cab * CFrame.new(0,0.34,-0.66)
    elseif alvo=="bunda" then
        return raiz * CFrame.new(0,-0.58,0.66)
    else
        return raiz * CFrame.new(0,-0.60,-0.62)
    end
end

--==================== BONECA (R15) ====================
local function criarBoneca()
    if S.boneca and S.boneca.model and S.boneca.model.Parent then S.boneca.model:Destroy() end
    S.jigs,S.peleParts,S.nips,S.particulas,S.roupa,S.dedos,S.olhos,S.palpebras,S.seios,S.marcas =
        {},{},{},{},{},{},{},{},{},{}
    local char = LP and LP.Character; if not char then return end
    local hrpJ = char:FindFirstChild("HumanoidRootPart"); if not hrpJ then return end

    local model = Instance.new("Model"); model.Name="VeniceBoneca"
    model.Parent = WS        -- << parenteia CEDO: build parcial fica visivel

    local lv = hrpJ.CFrame.LookVector
    local dirF = V3(lv.X,0,lv.Z); if dirF.Magnitude<0.01 then dirF=V3(0,0,-1) end; dirF=dirF.Unit
    local px = hrpJ.Position.X + dirF.X*3.0
    local pz = hrpJ.Position.Z + dirF.Z*3.0
    local gy = chaoEm(px, pz, hrpJ.Position.Y)
    local base = CFrame.lookAt(V3(px, gy+ALT_ROOT, pz), V3(px, gy+ALT_ROOT, pz) - dirF)

    local cor = COR.pele
    local r, rb = RAIO_SEIO, RAIO_BUNDA
    local sag = S.caimento or 0.5

    local function parte(nome, size, cf, c, forma, trans)
        local p = Instance.new("Part")
        p.Name=nome; p.Size=size; p.Color=c or cor
        p.Material=Enum.Material.SmoothPlastic; p.Reflectance=0.02
        p.Anchored,p.CanCollide,p.Massless,p.CastShadow=false,false,true,false
        p.CanQuery,p.CanTouch=false,false
        p.Shape=forma or Enum.PartType.Block
        p.Transparency=trans or 0; p.CFrame=cf; p.Parent=model
        p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
        return p
    end

    -- ===== R15: nomes e hierarquia =====
    local hrp      = parte("HumanoidRootPart", V3(1.6,1.6,1.0), base, cor, nil, 1); hrp.Anchored = true
    local tronco   = parte("UpperTorso", V3(1.6,1.6,1.0), base, cor, nil, 1)
    local lowerT   = parte("LowerTorso", V3(1.6,1.6,1.0), base, cor, nil, 1)
    local cabeca   = parte("Head", V3(1.36,1.42,1.42), base*CFrame.new(0,1.55,0), cor, Enum.PartType.Ball)

