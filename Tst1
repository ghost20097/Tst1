local function ligarLoop()
    local conn = RunService.RenderStepped:Connect(function(rawdt)
        local dt = math.min(rawdt, 1/30)
        local char = LP and LP.Character; if not char then return end
        local hrpJ = char:FindFirstChild("HumanoidRootPart"); if not hrpJ then return end
        local t = tick()

        atualizarFisio(dt)
        atualizarVergonha(dt)
        atualizarMasturbacao(dt)
        atualizarPrelim(dt)

        local look = hrpJ.CFrame.LookVector
        local flat = V3(look.X,0,look.Z); if flat.Magnitude<0.01 then flat=V3(0,0,-1) end; flat=flat.Unit
        local baseRot = CFrame.lookAt(V3(), flat)
        if S.raiva and S.aura and S.aura.Parent then S.aura.CFrame = hrpJ.CFrame end
        if not (S.boneca and S.boneca.model.Parent) then return end

        local pose = POSES[S.poseIdx] or POSES[1]
        local a = S.tesao/100
        local br = sin(S.resp*pi*2)

        local function setMotores(tab)
            for sem,m in pairs(S.boneca.motores) do
                if m.Parent then
                    local extra = IDENT
                    if sem=="cabeca" then extra = (tab and tab.extraCab) or IDENT end
                    m.C0 = (S.boneca.baseJ[sem] or IDENT) * ((tab and tab.mot[sem]) or IDENT) * extra
                end
            end
        end

        if S.sexo and S.picaWeld and S.picaWeld.Parent then
            local oral  = pose.oral
            local chupa = pose.chupar
            local vert  = pose.vertical
            local pitch = pose.pica or 0
            local alvo  = oral and "boca" or "buceta"
            local tl    = alvoLocal(pose, alvo)

            local baseW  = hrpJ.CFrame * S.picaBase
            local dirW   = (baseW * P(pitch,0,0)).UpVector
            local basePos= baseW.Position
            local tipW   = basePos + dirW*(S.picaL*1.02)
            local desiredRot = baseRot * pose.rot

            local piv
            if chupa then
                local hd = char:FindFirstChild("Head")
                piv = hd and (hd.CFrame*CFrame.new(0,-0.22,-0.34)).Position
                   or (hrpJ.CFrame*CFrame.new(0,1.25,-0.55)).Position
            elseif oral and pose.pivPica then
                piv = basePos + dirW*(S.picaL*0.55)
            else
                piv = tipW
            end

            -- ancora de mundo com mola
            local ideal = piv - (desiredRot * tl).Position
            if not S.ancoraOk then
                S.ancoraPos = ideal; S.ancoraVel = V3(); S.ancoraOk = true
                local _, yaw = desiredRot:ToEulerAnglesYXZ()
                criarLeito(S.ancoraPos.Y + (pose.sup or -99), yaw)
            else
                local err = ideal - S.ancoraPos
                S.ancoraVel = S.ancoraVel + err*55*dt - S.ancoraVel*12*dt
                S.ancoraPos = S.ancoraPos + S.ancoraVel*dt
            end

            local est = (chupa and sin(t*2.4)*0.05) or (abs(sin(t*S.vel))*S.amp)
            S.prof = est/math.max(0.001,S.amp)

            S.boneca.hrp.CFrame = CFrame.new(S.ancoraPos - dirW*(est*0.5))
                                  * desiredRot * CFrame.new(0, S.ajY, S.ajZ)
            S.picaWeld.C0 = S.picaBase * P(pitch,0,0) * CFrame.new(0, est*0.5, 0)

            local gag = oral and clamp((S.prof-0.6)/0.4,0,1) or 0
            setMotores({ mot=pose.mot, extraCab=P(-17*gag - 1.5*br,0,0) })

            if S.bocaInfW and S.bocaInfW.Parent then
                local abre = oral and 0.30 or clamp(est*0.9,0,0.35)
                S.bocaInfW.C0 = S.bocaInfBase * CFrame.new(0, -abre*0.35, 0)
            end
            local abre = chupa and 0.40 or clamp(est*0.85,0,0.42)
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end

            for _,p in ipairs(S.picaParts) do
                if p.Parent and p.Name~="Neko_Precum" then
                    local molhado = chupa and 0 or clamp(est/math.max(0.01,S.amp),0,1)
                    p.Material = molhado>0.35 and Enum.Material.Glass or Enum.Material.SmoothPlastic
                    p.Transparency = molhado*0.10
                end
            end
            if S.precumW and S.precumW.Parent then
                S.precumW.C0 = S.precumBase * CFrame.new(0, 0, -0.02 - S.ereccao*0.04)
                S.precum.Transparency = 1 - S.ereccao*0.85
                S.precum.Size = V3(0.13,0.15,0.13)*(0.6+S.ereccao*0.8)
            end

            S.babaT = S.babaT + dt
            local lim = oral and 0.9 or 2.4
            if S.babaT > lim then
                S.babaT = 0
                if oral then gemido(rnd()<0.6 and "oral" or "normal")
                elseif chupa then gemido(rnd()<0.6 and "chupa" or "fala")
                else gemido(rnd()<0.25 and "fala" or (vert and "montar" or "normal")) end
            end
            if not chupa and not oral then
                S.somT = S.somT + dt
                if S.somT > 1/math.max(1,S.vel*0.9) then
                    S.somT = 0; som("estoc",0.35,0.85,1.2)
                    if S.molhada>0.4 then som("squish",0.3,0.8,1.25) end
                end
            end
            if oral then
                local mp = S.boneca.tronco.CFrame * alvoLocal(pose,"boca")
                S.engasgo = S.engasgo + dt
                if gag>0.5 and S.engasgo>0.5 then
                    S.engasgo=0; gemido("oral"); babar(mp.Position, V3((rnd()-0.5)*2,-1,(rnd()-0.5)*2))
                end
                if rnd()<0.22 then babar(mp.Position, V3((rnd()-0.5)*1.5,-2,(rnd()-0.5)*1.5)) end
                S.cuspeT = S.cuspeT + dt
                if S.cuspeT>1.6 then
                    S.cuspeT=0
                    local tip2 = (S.picaWeld.Part0.CFrame*S.picaWeld.C0*CFrame.new(0,S.picaL*0.9,0)).Position
                    local dir = tip2-mp.Position
                    if dir.Magnitude>0.05 then fluido(mp.Position, dir.Unit*9, Color3.fromRGB(235,248,255),0.09,false) end
                end
            end
            if not oral and S.molhada>0.25 and rnd()<S.molhada*0.25 then
                local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.74,-0.68)
                gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
            end
            if chupa then
                S.mijaT = S.mijaT + dt
                if S.mijaT>1.0 then
                    S.mijaT=0
                    if rnd()<0.05 then mijar(); task.delay(1.4, function() eventoRaiva() end) end
                end
            end

        elseif S.prelim then
            local px = hrpJ.Position.X + flat.X*1.20
            local pz = hrpJ.Position.Z + flat.Z*1.20
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+ALT_ROOT, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.015,0)
            setMotores({ mot=POSES[4].mot })
            local meuTorso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            if meuTorso then
                local rel = S.boneca.hrp.CFrame:PointToObjectSpace(meuTorso.Position)
                for _, lado in ipairs({-1,1}) do
                    local nm = lado>0 and "R" or "L"
                    local T = V3(rel.X + lado*0.42, rel.Y + 0.30 + sin(t*1.3+lado)*0.08, rel.Z + 0.10)
                    setIK(S.boneca.motores["braco"..nm], S.boneca.motores["cotovelo"..nm],
                          V3(lado*0.80,0.72,0), T, LEN_BRACO, LEN_ANTEBRACO, V3(lado*1.5,0.1,0.5))
                end
            end

        elseif S.masturbando then
            local px = hrpJ.Position.X + flat.X*2.6
            local pz = hrpJ.Position.Z + flat.Z*2.6
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+0.95, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            local PM = { raiz=P(-14,0,0), cabeca=P(16,0,0),
                         quadrilL=P(88,0,-30), quadrilR=P(88,0,30),
                         joelhoL=P(-84,0,0), joelhoR=P(-84,0,0),
                         bracoL=P(60,0,-26), bracoR=P(18,0,10),
                         cotoveloL=P(-70,0,0), cotoveloR=P(-30,0,0) }
            setMotores({ mot=PM, extraCab=P(-2*br,0,0) })
            local dedo = 0.5 + sin(t*3.4)*0.5
            setIK(S.boneca.motores.bracoR, S.boneca.motores.cotoveloR, V3(0.80,0.72,0),
                  V3(0.10, -0.32, -0.62 - dedo*0.16), LEN_BRACO, LEN_ANTEBRACO, V3(2.1,-0.1,0.6))
            for _, d in ipairs(S.dedos) do
                if d.w.Parent then d.w.C0 = d.base * P(38 + dedo*10, 0, 0) end
            end
            local abre = 0.30 + dedo*0.16
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end
            S.mastOrg = S.mastOrg + dt
            if S.mastOrg > 2.2 then
                S.mastOrg = 0; gemido(rnd()<0.6 and "mast" or "normal")
                if S.molhada > 0.45 and rnd()<0.4 then
                    local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.74,-0.68)
                    gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
                end
            end

        else
            local px = hrpJ.Position.X + flat.X*2.4
            local pz = hrpJ.Position.Z + flat.Z*2.4
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+ALT_ROOT, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            setMotores({ mot=POSES[4].mot, extraCab=P(-1.2*br,0,0) })
        end

        aplicarJigs(dt)
        atualizarMaos(dt)
        atualizarCabeca(dt)
        atualizarOlhos(dt)
        atualizarPes(dt)

        local respVel
        if S.sexo and S.tesao > 85 then respVel = 0.06
        else respVel = 0.28 + a*0.55 + S.vergonha*0.30 + (S.raiva and 0.35 or 0) end
        S.resp = S.resp + dt*respVel
        if S.realResp then
            local peito = S.boneca.tronco:FindFirstChild("Peito")
            if peito then peito.Size = V3(1.68, 0.52+br*0.03, 0.92+br*0.05) end
        end
        S.pisca = S.pisca + dt
        if S.pisca > 2.6 + rnd()*2.4 then
            S.pisca = 0
            task.spawn(function()
                S.olhoFechado = math.max(S.olhoFechado, 1)
                task.wait(0.10)
                S.olhoFechado = 0
            end)
        end
        if S.trem > 0.12 then
            S.boneca.hrp.CFrame = S.boneca.hrp.CFrame*CFrame.new((rnd()-0.5)*0.03*S.trem,(rnd()-0.5)*0.03*S.trem,0)
        end
    end)
    S.conns[#S.conns+1] = conn
end

