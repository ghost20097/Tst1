local function pontoEjac()
    local b = S.boneca
    local a = S.ejacAlvo
    if a=="rosto" then return b.cabeca.CFrame*CFrame.new(0,0.12,-0.82)
    elseif a=="boca" then return b.cabeca.CFrame*CFrame.new(0,-0.42,-0.72)
    elseif a=="bunda" then return b.tronco.CFrame*CFrame.new(0,-0.52,0.78)
    elseif a=="seios" then return b.tronco.CFrame*CFrame.new(0,0.28,-0.88)
    elseif a=="fora" then return b.tronco.CFrame*CFrame.new(0,-0.60,-1.18)
    else return b.tronco.CFrame*CFrame.new(0,-0.62,-0.70) end
end

