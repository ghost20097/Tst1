    local origem
    if baseCF then origem = baseCF
    else
        local char = LP and LP.Character
        local hrpJ = char and char:FindFirstChild("HumanoidRootPart")
        if not hrpJ then return end
        origem = hrpJ.CFrame
    end

    local lv = origem.LookVector
    local dirF = V3(lv.X,0,lv.Z); if dirF.Magnitude<0.01 then dirF=V3(0,0,-1) end; dirF=dirF.Unit
    local px = origem.Position.X + dirF.X*CFG.DIST_SPAWN
