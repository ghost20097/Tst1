            elseif pose.titfuck then
                for _,lado in ipairs({-1,1}) do
                    local nm = lado>0 and "D" or "E"
                    setIK(S.boneca.motores["braco"..nm], S.boneca.motores["cotovelo"..nm],
                          V3(lado*0.80,0.72,0), picaLocal + V3(lado*0.30,-0.05,0.05),
                          LEN_BRACO, LEN_ANTEBRACO, V3(lado*1.6,-0.2,-0.4))
                end
            elseif pose.handjob then
                setIK(S.boneca.motores.bracoD, S.boneca.motores.cotoveloD,
                      V3(0.80,0.72,0), picaLocal + V3(0.05,0,-0.05),
                      LEN_BRACO, LEN_ANTEBRACO, V3(1.6,-0.1,-0.6))
            end

            if S.boneca.bocaInf then
                local abre = (oral or S.props.bola) and 0.30 or clamp(est*0.9,0,0.35)
                S.boneca.bocaInf.CFrame = S.boneca.cabeca.CFrame * CFrame.new(0,-0.47-abre*0.35,-0.65)
            end
            local abre = chupa and 0.40 or clamp(est*0.85,0,0.42)
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end
            S.picaWeld.C0 = S.picaBase * CFrame.new(0,est*0.72,0)
            for _,p in ipairs(S.picaParts) do
                if p.Parent and p.Name~="Neko_Precum" then
                    local molhado = chupa and 0 or clamp(est/S.ampEf,0,1)
                    p.Material = molhado>0.35 and Enum.Material.Glass or Enum.Material.SmoothPlastic
                    p.Transparency = molhado*0.10
                end
            end
            if S.precum and S.precum.Parent and S.picaRaiz then
                S.precum.CFrame = S.picaRaiz.CFrame*CFrame.new(0,S.picaL*1.18,-0.03)
                S.precum.Transparency = 1-S.ereccao
            end
            S.babaT = S.babaT + dt
            local lim = oral and 0.9 or 2.4
            if S.babaT > lim then
                S.babaT = 0
                if oral then gemido(rnd()<0.6 and "oral" or "normal")
                elseif chupa then gemido(rnd()<0.6 and "chupa" or "fala")
                else gemido(rnd()<0.25 and "fala" or (vert and "montar" or "normal")) end
            end
            if not chupa and not oral then
                S.somT = S.somT + dt
                if S.somT > 1/math.max(1,S.velEf*0.9) then
                    S.somT = 0; som("estoc",0.35+S.rough*0.12,0.85,1.2)
                    if S.molhada>0.4 then som("squish",0.3,0.8,1.25) end
                end
                -- brutalidade: marcas extras
                if S.rough > 0.8 and rnd() < S.rough*0.02 then
                    local pai = (alvo=="bunda") and S.boneca.tronco or S.boneca.tronco
                    marcasDedo(pai, CFrame.new(0,-0.55, alvo=="bunda" and 0.70 or -0.72))
                end
            end
            if oral then
                local mp = S.boneca.tronco.CFrame * alvoLocal(pose,"boca")
                S.engasgo = S.engasgo + dt
                if gag>0.5 and S.engasgo>0.5 then
                    S.engasgo=0; gemido("oral"); babar(mp.Position, V3((rnd()-0.5)*2,-1,(rnd()-0.5)*2))
                end
                if rnd()<0.22 then babar(mp.Position, V3((rnd()-0.5)*1.5,-2,(rnd()-0.5)*1.5)) end
                S.cuspeT = S.cuspeT + dt
                if S.cuspeT>1.6 then
                    S.cuspeT=0
                    local tip = (S.picaWeld.Part0.CFrame*S.picaBase*CFrame.new(0,S.picaL*0.9,0)).Position
                    local dir = tip-mp.Position
                    if dir.Magnitude>0.05 then fluido(mp.Position, dir.Unit*9, Color3.fromRGB(235,248,255),0.09,false) end
                end
            end
            if not oral and S.molhada>0.25 and rnd()<S.molhada*0.25 then
                local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.66,-0.68)
                gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
            end
            if chupa then
                S.mijaT = S.mijaT + dt
                if S.mijaT>1.0 then
                    S.mijaT=0
                    if rnd()<0.05 then mijar(); task.delay(1.4, function() eventoRaiva() end) end
                end
            end

        elseif S.prelim then
            local px = hrpJ.Position.X + flat.X*1.20
            local pz = hrpJ.Position.Z + flat.Z*1.20
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+CFG.ALT_QUADRIL, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.015,0)
            setMotores({ mot=POSES[4].motores })
            local meuTorso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
            if meuTorso then
                local rel = S.boneca.hrp.CFrame:PointToObjectSpace(meuTorso.Position)
                for _, lado in ipairs({-1,1}) do
                    local nm = lado>0 and "D" or "E"
                    local T = V3(rel.X + lado*0.42, rel.Y + 0.30 + sin(t*1.3+lado)*0.08, rel.Z + 0.10)
                    setIK(S.boneca.motores["braco"..nm], S.boneca.motores["cotovelo"..nm],
                          V3(lado*0.80,0.72,0), T, LEN_BRACO, LEN_ANTEBRACO, V3(lado*1.4,0.1,0.5))
                end
            end

        elseif S.masturbando then
            local px = hrpJ.Position.X + flat.X*2.6
            local pz = hrpJ.Position.Z + flat.Z*2.6
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+0.85, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            local PM = { raiz=P(-14,0,0), cabeca=P(16,0,0),
                         quadrilE=P(88,0,-30), quadrilD=P(88,0,30),
                         joelhoE=P(-84,0,0), joelhoD=P(-84,0,0),
                         bracoE=P(60,0,-26), bracoD=P(18,0,10),
                         cotoveloE=P(-70,0,0), cotoveloD=P(-30,0,0) }
            setMotores({ mot=PM, extraCab=P(-2*br,0,0) })
            local dedo = 0.5 + sin(t*3.4)*0.5
            setIK(S.boneca.motores.bracoD, S.boneca.motores.cotoveloD, V3(0.80,0.72,0),
                  V3(0.10, -0.60, -0.62 - dedo*0.16), LEN_BRACO, LEN_ANTEBRACO, V3(1.9,-0.1,0.6))
            for _, d in ipairs(S.dedos) do
                if d.w.Parent then d.w.C0 = d.base * P(38 + dedo*10, 0, 0) end
            end
            local abre = 0.30 + dedo*0.16
            for _,l in ipairs(S.boneca.vulva.labios) do
                if l.w and l.w.Parent then l.w.C0 = l.base*CFrame.new(l.lado*abre*0.55,0,-abre*0.30) end
            end
            S.mastOrg = S.mastOrg + dt
            if S.mastOrg > 2.2 then
                S.mastOrg = 0; gemido(rnd()<0.6 and "mast" or "normal")
                if S.molhada > 0.45 and rnd()<0.4 then
                    local pv = S.boneca.tronco.CFrame*CFrame.new(0,-0.66,-0.68)
                    gota(pv.Position, V3((rnd()-0.5)*1.2,-1.5,(rnd()-0.5)*1.2), COR.gota, true)
                end
            end

        else
            local px = hrpJ.Position.X + flat.X*2.4
            local pz = hrpJ.Position.Z + flat.Z*2.4
            local gy = chaoEm(px, pz, hrpJ.Position.Y)
            S.boneca.hrp.CFrame = CFrame.new(px, gy+CFG.ALT_QUADRIL, pz)*baseRot*P(0,180,0)*CFrame.new(0,br*0.02,0)
            setMotores({ mot=POSES[4].motores, extraCab=P(-1.2*br,0,0) })
        end

        aplicarJigs(dt)
        atualizarMaos(dt)
        atualizarCabeca(dt)
        atualizarOlhos(dt)
        atualizarPes(dt)

        -- props: vibrador treme, rabo mexe
        local vib = S.propParts.vibrador
        if vib and vib.w and vib.w.Parent then
            vib.w.C0 = CFrame.new((rnd()-0.5)*0.02, 0, -0.78 + sin(t*22)*0.03) * P(0,90,0)
        end
        for i,seg in ipairs(S.caudas) do
            if seg and seg.Parent then
                seg.CFrame = seg.CFrame * P(0, sin(t*1.8 + i*0.4)*1.2, 0)
            end
        end

        local respVel
        if S.sexo and S.tesao > 85 then respVel = 0.06
        else respVel = 0.28 + a*0.55 + S.vergonha*0.30 + (S.raiva and 0.35 or 0) + (1-S.stamina)*0.4 end
        S.resp = S.resp + dt*respVel
        if S.realResp then
            local cost = S.boneca.tronco:FindFirstChild("Costelas")
            if cost then cost.Size = V3(1.72, 0.78+br*0.03, 0.94+br*0.05) end
        end
        S.pisca = S.pisca + dt
        if S.pisca > 2.6 + rnd()*2.4 then
            S.pisca = 0
            task.spawn(function()
                S.olhoFechado = math.max(S.olhoFechado, 1)
                task.wait(0.10)
                S.olhoFechado = 0
            end)
        end
        if S.trem > 0.12 then
            S.boneca.hrp.CFrame = S.boneca.hrp.CFrame*CFrame.new((rnd()-0.5)*0.03*S.trem,(rnd()-0.5)*0.03*S.trem,0)
        end
    end)
    S.conns[#S.conns+1] = conn
end

