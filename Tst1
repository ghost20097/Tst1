    local partes = {}
    local function pp(nome,c0,tam,c,forma,extra) local p=peca(nome,raiz,c0,tam,c,forma,extra); partes[#partes+1]=p; return p end
    pp("Neko_Saco", CFrame.new(0,-L*0.16,0.03), V3(d*1.5,d*0.9,d*1.1), COR.pica)
    for _,lado in ipairs({-1,1}) do
        pp("Neko_Bola", CFrame.new(lado*d*0.62,-L*0.14,0.03)*P(0,0,lado*14), V3(d*0.85,d*0.95,d*0.85), COR.pica)
