    p.Anchored,p.CanCollide,p.CanQuery,p.CanTouch,p.CastShadow=true,false,false,false,false
    p.Parent=WS; S.pocoes[#S.pocoes+1]=p
    if #S.pocoes>CFG.MAX_POCAS then local o=table.remove(S.pocoes,1) if o and o.Parent then o:Destroy() end end
    task.spawn(function()
        local t0=tick()
        while p.Parent and tick()-t0<16 do
            local k=(tick()-t0)/16
            p.Size=V3(0.02,raio*(1+k*0.6),raio*(1+k*0.6)); p.Transparency=0.2+k*0.55
            task.wait(0.14)
        end
