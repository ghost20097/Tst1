        local ante, mAnte = membro("LowerArm", braco, V3(0,-LEN_BRACO/2,0), LEN_ANTEBRACO, 0.19, ladoNome)
        M["cotovelo"..ladoNome] = mAnte
        local mao = peca("Hand"..ladoNome, ante, CFrame.new(0,-LEN_ANTEBRACO/2-0.14,0), V3(0.30,0.34,0.22), cor)
        pele(mao)
