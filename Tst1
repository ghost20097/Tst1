local function frameAim(pos, dir, ref)
    local y = -dir
    local x = ref:Cross(y)
    if x.Magnitude < 1e-5 then x = V3(1,0,0):Cross(y) end
    x = x.Unit
    local z = x:Cross(y)
    return CFrame.fromMatrix(pos, x, y, z)
end
local function setIK(m1, m2, J, T, len1, len2, pole)
    if not (m1 and m1.Parent and m2 and m2.Parent) then return end
    local delta = T - J
    local d = clamp(delta.Magnitude, 0.02, len1+len2-0.02)
    local dir = delta.Unit
    local cosA = clamp((len1*len1 + d*d - len2*len2)/(2*len1*d), -1, 1)
    local A = acos(cosA)
    local pv = pole - J
    local perp = pv - dir*(pv:Dot(dir))
    if perp.Magnitude < 1e-4 then perp = V3(0,0,-1) end
    perp = perp.Unit
    local dir1 = dir*cos(A) + perp*sin(A)
    local E = J + dir1*len1
    local dir2 = T - E
    dir2 = dir2.Magnitude < 1e-4 and dir or dir2.Unit
    local F1 = frameAim(J, dir1, perp)
    local F2 = frameAim(E, dir2, perp)
    m1.C0 = F1
    m2.C0 = CFrame.new(0, len1/2, 0) * F1:Inverse() * F2
end
