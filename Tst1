local function alvoLocal(pose, alvo)
    local raiz = pose.motores.raiz or IDENT
    if alvo=="boca" then
        local cab = pose.motores.cabeca or IDENT
        return raiz * CFrame.new(0,1.05,0) * cab * CFrame.new(0,0.34,-0.74)
    elseif alvo=="bunda" then return raiz * CFrame.new(0,-0.58,0.66)
    elseif alvo=="seios" then return raiz * CFrame.new(0,0.28,-0.80)
    elseif alvo=="maos" then return raiz * CFrame.new(0,-0.05,-0.78)
    elseif alvo=="pes" then return raiz * CFrame.new(0,-0.28,-0.95)
    elseif alvo=="coxa" then return raiz * CFrame.new(0,-0.72,-0.60)
    else return raiz * CFrame.new(0,-0.60,-0.62) end
end

