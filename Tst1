local function removerPica()
    local char = LP and LP.Character; if not char then return end
    for _,d in ipairs(char:GetDescendants()) do
        local n=d.Name
        if n:sub(1,10)=="Neko_Pica" or n=="Neko_Bola" or n=="Neko_Saco" or n=="Neko_WeldPica" or n=="Neko_Precum" then
            pcall(function() d:Destroy() end)
        end
    end
    S.picaRaiz,S.picaWeld,S.picaCabeca,S.precum=nil,nil,nil,nil
end

