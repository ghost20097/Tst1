end

criarDollRemota = function(plr)
    if not plr or not plr.Parent then return end
    local existente = S.remotos[plr]
    if existente and existente.doll and existente.doll.model and existente.doll.model.Parent then
        return existente
    end
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local baseCF = hrp and hrp.CFrame or nil

    local salvo = capturarEstado()
    S.boneca = nil
    S.jigs,S.peleParts,S.nips,S.particulas,S.roupa,S.dedos,S.olhos,S.palpebras,S.seios,S.marcas = {},{},{},{},{},{},{},{},{},{}
    S.bundas,S.caudas,S.propParts = {},{},{}
    local ok, err = pcall(criarBoneca, baseCF)
    local doll = S.boneca
    local roupa = S.roupa
    restaurarEstado(salvo)
    if not (ok and doll and doll.model and doll.model.Parent) then logErr("dollRemota", err); return end
    local rec = { doll=doll, roupa=roupa, pica=nil }
    S.remotos[plr] = rec
    return rec
end

local ultimoId = {}
local function aplicarRemoto(plr, dados)
    if plr == LP or type(dados) ~= "table" then return end
    if dados.id and ultimoId[plr] == dados.id then return end
    ultimoId[plr] = dados.id
    local rec = S.remotos[plr]
    if dados.spawn and not (rec and rec.doll and rec.doll.model.Parent) then
        if #S.remotos >= CFG.MAX_REMOTOS then
            for k,v in pairs(S.remotos) do
                if v.doll and v.doll.model then v.doll.model:Destroy() end
                S.remotos[k] = nil; break
            end
        end
        rec = criarDollRemota(plr)
        if aviso then aviso("Boneca de "..plr.Name.." apareceu!") end
    end
    rec = S.remotos[plr]
    if not (rec and rec.doll and rec.doll.model.Parent) then return end
    local d = rec.doll
    if dados.cf then d.hrp.CFrame = dados.cf end
    if dados.mot then
        for nome, c0 in pairs(dados.mot) do
            local m = d.motores[nome]
            if m and m.Parent then m.C0 = c0 end
        end
    end
    if dados.roupa then
        for nome, on in pairs(dados.roupa) do
            local g = rec.roupa[nome]
            if g then
                for _, it in ipairs(g.parts) do
                    if it.p and it.p.Parent then it.p.Transparency = on and 0 or 1 end
                end
            end
        end
    end
    if dados.pica ~= nil then
        if dados.pica and not rec.pica then
            local p = Instance.new("Part"); p.Name="RemotaPica"
            p.Size=V3(0.25,0.25,1.1); p.Color=COR.pica; p.Anchored=true
            p.CanCollide=false; p.CanQuery=false; p.Parent=WS; rec.pica=p
        elseif not dados.pica and rec.pica then
            rec.pica:Destroy(); rec.pica=nil
        end
        if rec.pica and dados.pica then rec.pica.CFrame = dados.pica end
    end
end

Players.PlayerRemoving:Connect(function(plr)
    local rec = S.remotos[plr]
    if rec then
        if rec.doll and rec.doll.model then rec.doll.model:Destroy() end
        if rec.pica then rec.pica:Destroy() end
        S.remotos[plr] = nil
    end
    ultimoId[plr] = nil
end)

local function enviarNet()
    if not (S.netOn and net and not IS_SERVER and S.boneca and S.boneca.model.Parent) then return end
    S.netId = S.netId + 1
    local mot = {}
    for nome, m in pairs(S.boneca.motores) do if m.Parent then mot[nome] = m.C0 end end
    local roupa = {}
    for nome, g in pairs(S.roupa) do roupa[nome] = g.on end
    local picaCF = S.picaWeld and (S.picaWeld.Part0.CFrame * S.picaWeld.C0) or nil
    net:FireServer("sync", { id=S.netId, spawn=true, cf=S.boneca.hrp.CFrame,
        mot=mot, roupa=roupa, pica=picaCF })
end

