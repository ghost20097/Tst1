local function removerBoneca()
    if S.boneca and S.boneca.model then pcall(function() S.boneca.model:Destroy() end) end
    S.boneca=nil; S.sexo=false; S.prelim=false; S.masturbando=false
    S.jigs,S.peleParts,S.nips,S.particulas,S.roupa,S.dedos,S.olhos,S.palpebras,S.seios,S.marcas = {},{},{},{},{},{},{},{},{},{}
    S.bundas,S.caudas,S.propParts = {},{},{}
end

--==================== CORPO (sliders) ====================
aplicarCorpo = function()
    if not S.boneca then return end
    for _, s in ipairs(S.seios) do
        if s.p.Parent then s.p.Size = s.base * S.sliderSeio end
    end
    for _, b in ipairs(S.bundas) do
        if b.p.Parent then b.p.Size = b.base * S.sliderBunda end
    end
    if S.cintura and S.cintura.Parent and S.cinturaBase then
        S.cintura.Size = V3(S.cinturaBase.X*S.sliderCintura, S.cinturaBase.Y, S.cinturaBase.Z*S.sliderCintura)
    end
end

