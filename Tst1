            local cf = CFrame.new(fx,-0.26,-0.02)
            local _, w = peca("Dedo"..f..ladoNome, mao, cf, V3(0.07,0.32,0.09), cor)
            S.dedos[#S.dedos+1] = { w=w, base=cf }
            peca("Unha"..f..ladoNome, mao, cf*CFrame.new(0,-0.19,-0.03), V3(0.06,0.08,0.06), COR.unha)
        end
        peca("Polegar"..ladoNome, mao, CFrame.new(lado*-0.17,-0.08,-0.02), V3(0.09,0.24,0.09), cor, Enum.PartType.Block, P(0,0,lado*-30))

        -- PERNA
        local quaJ = peca("HipJ"..ladoNome, lowerT, V3(lado*0.48,-0.30,0), V3(0.62,0.62,0.62), cor)
        pele(quaJ)
        local coxa, mCoxa = membro("UpperLeg", lowerT, V3(lado*0.48,-0.30,0), LEN_COXA, 0.42, ladoNome)
        M["quadril"..ladoNome] = mCoxa
        local joeJ = peca("KneeJ"..ladoNome, coxa, CFrame.new(0,-LEN_COXA/2,0), V3(0.54,0.54,0.54), cor)
        pele(joeJ)
        local canela, mCanela = membro("LowerLeg", coxa, V3(0,-LEN_COXA/2,0), LEN_CANELA, 0.33, ladoNome)
        M["joelho"..ladoNome] = mCanela
        local torn = peca("Ankle"..ladoNome, canela, CFrame.new(0,-LEN_CANELA/2-0.10,0), V3(0.36,0.36,0.36), cor); pele(torn)
        local pe = peca("Foot"..ladoNome, torn, CFrame.new(0,-0.14,-0.22), V3(0.42,0.24,0.84), cor); pele(pe)
        peca("Toes"..ladoNome, pe, CFrame.new(0,0,-0.43), V3(0.42,0.22,0.16), cor)
    end

    local baseJ = {}
    for k, m in pairs(M) do baseJ[k] = m.C0 end

    local function suor(pai, tam)
        if not pai then return end
        local at = Instance.new("Attachment"); at.Parent = pai
        local pe = Instance.new("ParticleEmitter")
        pe.Texture="rbxassetid://243660364"
        pe.Color=ColorSequence.new(Color3.fromRGB(245,250,255))
        pe.Transparency=NumberSequence.new(0.35)
        pe.Lifetime=NumberRange.new(0.7,1.2); pe.Rate=0
        pe.Speed=NumberRange.new(0.6,1.6); pe.SpreadAngle=Vector2.new(180,180)
        pe.Size=NumberSequence.new(tam)
        pe.LightEmission=0.4; pe.Parent=at
        S.particulas[#S.particulas+1]=pe
    end
    suor(tronco:FindFirstChild("Peito") or tronco, 0.10)
    suor(cab, 0.08)

    model.PrimaryPart = hrp
    S.boneca = { model=model, hrp=hrp, tronco=tronco, lowerTorso=lowerT, cabeca=cabeca,
                 motores=M, baseJ=baseJ, vulva=vulva, bocaSup=bocaSup, bocaInf=bocaInf }
    S.lastPos = hrp.CFrame
    local ok, err = pcall(construirRoupa)
    if not ok then logErr("roupa", err) end
end

local function removerBoneca()
    if S.boneca and S.boneca.model then pcall(function() S.boneca.model:Destroy() end) end
    S.boneca=nil; S.sexo=false; S.prelim=false; S.masturbando=false
    S.jigs,S.peleParts,S.nips,S.particulas,S.roupa,S.dedos,S.olhos,S.palpebras,S.seios,S.marcas =
        {},{},{},{},{},{},{},{},{},{}
end

--==================== ROUPA ====================
construirRoupa = function()
    local b = S.boneca; if not b then return end
    local tr = b.tronco
    local function grupo(nome, builder)
        local g = { on=true, parts={}, builder=builder }
        S.roupa[nome] = g; builder(g, tr)
    end
    local function add(g, pai, c0, tam, cor, forma, extra, mat)
        if not pai then return nil end
        local p,w = peca("Roupa_"..pai.Name, pai, c0, tam, cor, forma, extra, mat or Enum.Material.Fabric)
        g.parts[#g.parts+1] = { p=p, w=w }
        return p
    end
    grupo("sutia", function(g, tr)
        add(g, tr, CFrame.new(0,0.32,0), V3(1.76,0.30,0.92), COR.sutia)
        add(g, tr, CFrame.new(0,0.58,0), V3(1.74,0.16,0.90), COR.sutia)
        for _,lado in ipairs({-1,1}) do
            local seio = nil
            for _,s in ipairs(S.seios) do if s.lado==lado then seio = s.p end end
            if seio then
                add(g, seio, CFrame.new(0,-RAIO_SEIO*0.06,-RAIO_SEIO*0.22),
                    V3(RAIO_SEIO*2.08,RAIO_SEIO*2.02,RAIO_SEIO*2.20), COR.sutia)
            end
        end
    end)
    grupo("calcinha", function(g, tr)
        add(g, tr, CFrame.new(0,-0.42,0), V3(2.00,0.60,1.00), COR.calcinha)
        add(g, tr, CFrame.new(0,-0.50,-0.54), V3(0.90,0.44,0.28), COR.calcinha)
        g.mancha = add(g, tr, CFrame.new(0,-0.50,-0.66), V3(0.42,0.26,0.10),
                       Color3.fromRGB(220,205,225), nil, nil, Enum.Material.Glass)
    end)
    grupo("blusa", function(g, tr)
        add(g, tr, CFrame.new(0,0.40,0), V3(1.92,1.10,1.04), COR.blusa)
        add(g, tr, CFrame.new(0,-0.28,0), V3(1.54,0.60,0.92), COR.blusa)
    end)
    grupo("saia", function(g, tr)
        add(g, tr, CFrame.new(0,-0.58,0), V3(0.52,2.04,2.04), COR.saia,
            Enum.PartType.Cylinder, P(0,0,90))
    end)
end

local function tirarRoupa(nome)
    local g = S.roupa[nome]
    if not g or not g.on then return end
    g.on = false
    for _, item in ipairs(g.parts) do
        local p = item.p
        if p and p.Parent then
            if item.w then item.w:Destroy() end
            p.Anchored=false; p.CanCollide=true; p.Massless=false; p.CastShadow=true
            p.AssemblyLinearVelocity = V3((rnd()-0.5)*3, 0.5+rnd()*2, (rnd()-0.5)*3)
            p.AssemblyAngularVelocity = V3((rnd()-0.5)*8,(rnd()-0.5)*8,(rnd()-0.5)*8)
