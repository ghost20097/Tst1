        local ombroJ = peca("ShoulderJ"..ladoNome, tronco, V3(lado*0.80,0.72,0), V3(0.46,0.46,0.46), cor)
        pele(ombroJ)                                   -- <<< FIX (era pele(_))
        local braco, mBraco = membro("UpperArm", tronco, V3(lado*0.80,0.72,0), LEN_BRACO, 0.23, ladoNome)
        M["braco"..ladoNome] = mBraco
        local cotJ = peca("ElbowJ"..ladoNome, braco, CFrame.new(0,-LEN_BRACO/2,0), V3(0.38,0.38,0.38), cor)
