    removerProp(nome)
    local b = S.boneca
    local p, w
    if nome=="vibrador" then
        p, w = peca("Prop_Vibrador", b.tronco, CFrame.new(0,-0.60,-0.78)*P(0,90,0),
                    V3(0.46,0.11,0.11), COR.vibrador, Enum.PartType.Cylinder)
    elseif nome=="plug" then
        p, w = peca("Prop_Plug", b.tronco, CFrame.new(0,-0.60,0.70)*P(-20,0,0),
                    V3(0.13,0.24,0.13), COR.plug)
        peca("Prop_PlugBase", b.tronco, CFrame.new(0,-0.60,0.82), V3(0.22,0.05,0.22), COR.plug)
    elseif nome=="coleira" then
