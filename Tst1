    skin("Cintura",  tronco, CFrame.new(0,-0.16,0), V3(1.24,0.42,0.82))
    skin("Barriga",  tronco, CFrame.new(0,-0.40,-0.03), V3(1.34,0.40,0.84))
    skin("Costelas", tronco, CFrame.new(0,0.22,0),  V3(1.56,0.78,0.90))
    skin("Peito",    tronco, CFrame.new(0,0.56,0),  V3(1.68,0.52,0.92))
    skin("ClaviculaE", tronco, CFrame.new(-0.48,0.78,-0.34), V3(0.62,0.13,0.16))
