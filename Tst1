    botao("--- CAMERA ---", BLOCO, function() end)
    dropdown("CAMERA: livre", {"livre","espectador","cinematico"}, function(n)
        S.cameraModo = n
        if n=="livre" then
            local cam = WS.CurrentCamera
            if cam then cam.CameraType = Enum.CameraType.Custom end
        end
        aviso("Camera: "..n)
    end)

    -- ===== REALISMO =====
    botao("--- REALISMO / EXTRAS ---", BLOCO, function() end)
    local rZ1=linha()
    toggle(rZ1, "JIGGLE", "realJig", function()
        if not S.realJig and S.boneca then for _,j in ipairs(S.jigs) do j.off=V3(); if j.w.Parent then j.w.C0=j.base end end end
    end)
    toggle(rZ1, "RESPIRAR", "realResp")
    local rZ2=linha()
    toggle(rZ2, "SONS", "realSons")
    toggle(rZ2, "SUOR", "realSuor")
    local rZ3=linha()
    toggle(rZ3, "BLUSH", "realBlush")
    b2(rZ3,"VOL -", function() S.volSom=math.max(0,S.volSom-0.15); aviso("Vol") end)
    local rZ4=linha()
    b2(rZ4,"VOL +", function() S.volSom=math.min(1.5,S.volSom+0.15); aviso("Vol") end)
    b2(rZ4,"QUAL: "..S.qual, function() S.qual=S.qual%3+1; aviso("Qualidade "..S.qual) end)
    local rX=linha()
    toggle(rX, "OLHOS SEGUEM", "olhosSeguem")
    toggle(rX, "CABECA SEGUE", "cabecaSegue")
    local rX2=linha()
    toggle(rX2, "IK DOS PES", "ikPes")
    toggle(rX2, "MULTIPLAYER", "netOn", function()
        if S.netOn and not netOk then aviso("Rede sem resposta - modo local") end
    end)

    local rB=linha()
    b2(rB,"REMOVER BONECA", function() removerBoneca(); aviso("Removida") end)
    b2(rB,"REPOSICIONAR", function() criarBoneca(); aviso("Reposicionada") end)
    botao("SALVAR CONFIG", ALT, function() salvarCfg(); aviso("Config salva") end)
    botao("REMOVER TUDO", Color3.fromRGB(138,48,72), function()
        limparTudo(); bSexo.Text="SEXO: OFF"; bSexo.BackgroundColor3=BTN
        bPica.Text="PICA: OFF"; bPica.BackgroundColor3=BTN; aviso("Tudo removido")
    end)

    -- ARRASTAR
    local arr,ini,sp = false,nil,nil
    gc(barra.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            arr,ini,sp=true,input.Position,main.Position
            input.Changed:Connect(function() if input.UserInputState==Enum.UserInputState.End then arr=false end end)
        end
    end))
    gc(UIS.InputChanged:Connect(function(input)
        if not arr then return end
        if input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch then
            local d=input.Position-ini
            main.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end))
    local mini=false
    btnMin.MouseButton1Click:Connect(function()
        mini=not mini; corpo.Visible=not mini; track.Visible=not mini
        main.Size = mini and UDim2.new(0,250,0,26) or UDim2.new(0,250,0,600)
        btnMin.Text = mini and "+" or "-"
    end)

    gc(UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == CFG.TECLA then
            gui.Enabled = not gui.Enabled
            aviso(gui.Enabled and "GUI ON" or "GUI OFF")
        end
    end))

    return gui
end

