local function fazerPoca(pos, cor, raio)
    local p = Instance.new("Part")
    p.Name="Neko_Poca"; p.Shape=Enum.PartType.Cylinder
    p.Size=V3(0.02,raio,raio); p.CFrame=CFrame.new(pos)*CFrame.Angles(0,0,rad(90))
