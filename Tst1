    -- ===== MEMBROS (R15) =====
    local function membro(nome, pai, junta, len, raio, ladoNome)
        local osso = parte("Bone"..nome..ladoNome, V3(raio*0.95,len,raio*0.95), base, cor, nil, 1)
        osso.Transparency = 1
        local m = motor("M_"..nome..ladoNome, pai, osso, CFrame.new(junta), CFrame.new(0,len/2,0))
        local vis = peca("Vis"..nome..ladoNome, osso, IDENT, V3(len*1.02, raio*2, raio*2), cor, Enum.PartType.Cylinder, P(0,0,90))
        pele(vis)
        return osso, m
    end

    for _,lado in ipairs({-1,1}) do
        local ladoNome = lado>0 and "R" or "L"

