             cintura=S.cintura, cinturaBase=S.cinturaBase, caudas=S.caudas,
             lastPos=S.lastPos, accSm=S.accSm }
end
local function restaurarEstado(t)
    S.boneca=t.boneca; S.jigs=t.jigs; S.peleParts=t.peleParts; S.nips=t.nips
    S.particulas=t.particulas; S.roupa=t.roupa; S.dedos=t.dedos; S.olhos=t.olhos
    S.palpebras=t.palpebras; S.seios=t.seios; S.bundas=t.bundas; S.clit=t.clit; S.canal=t.canal
