    local lt  = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    if not (hrp and lt) then return end
    local sz = lt.Size
    local L = sz.X*0.60*S.tamPica
    local d = sz.X*0.20*S.gross
    local baseCF = CFrame.new(0,-(sz.Y*0.5+0.55)+S.picaY, -(sz.Z*0.5+0.12))*P(-74,0,0)
    local raiz = Instance.new("Part")
    raiz.Name="Neko_PicaRaiz"; raiz.Size=V3(0.1,0.1,0.1); raiz.Shape=Enum.PartType.Ball
    raiz.Color=COR.pica; raiz.Material=Enum.Material.SmoothPlastic
    raiz.Anchored,raiz.CanCollide,raiz.Massless,raiz.CastShadow=false,false,true,false
    raiz.CanQuery,raiz.CanTouch=false,false; raiz.Parent=char
    local w = Instance.new("Weld"); w.Name="Neko_WeldPica"
