    bloco("Travesseiro", V3(3.0,0.36,1.1), CFrame.new(0,alt+0.16,2.5), Color3.fromRGB(255,235,245))
    model.PrimaryPart = model.Colchao; model.Parent = WS; S.leito = model
end

